# Recommended for this local setup: use the already authenticated lark-cli.
LARK_WRITE_MODE=lark-cli

# Only required when LARK_WRITE_MODE=api.
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx

LARK_APP_TOKEN=bascn_xxx
LARK_TABLE_ID=tbl_xxx

# Optional local API guard. If set, use the same value in the extension options.
CAPTURE_API_KEY=
CAPTURE_PORT=8787

# Optional field-name mapping for your Feishu Base table.
FIELD_TITLE=标题
FIELD_URL=链接
FIELD_SOURCE=来源
FIELD_CORE_CONTENT=核心内容
FIELD_TAGS=标签
FIELD_PRIORITY=重要度
FIELD_STATUS=状态
FIELD_REMIND_AT=提醒时间
FIELD_CAPTURED_AT=保存时间
FIELD_SCREENSHOT=网页截图
FIELD_CALENDAR_EVENT_ID=日历事件ID

# For Feishu Base date fields, keep this as false. Set true only when those fields are plain text.
DATES_AS_TEXT=false
TAGS_AS_TEXT=false

# Turn this on to create/update aggregated Feishu calendar reminders.
# Records with the same reminder time are merged into one event, such as:
# 回看：13 条发财资料
CALENDAR_EVENTS_ENABLED=true
LARK_CALENDAR_ID=primary
READING_EVENT_DURATION_MINUTES=30
READING_REMINDER_MINUTES=0
REMINDER_SYNC_INTERVAL_MINUTES=1
